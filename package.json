    "bake": "bun tools/bake/run.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "playwright-core": "1.64.1",
    "three": "0.187.0",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
