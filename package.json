{
  "name": "sticky-frog",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "server/telemetry"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "bun check -p .",
