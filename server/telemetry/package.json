{
  "name": "sticky-frog-telemetry",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit -p . && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply sticky-frog-telemetry --local",
    "migrate:remote": "wrangler d1 migrations apply sticky-frog-telemetry --remote -c wrangler.local.jsonc",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy -c wrangler.local.jsonc",
    "report": "bun report.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@types/bun": "1.4.4",
    "drizzle-kit": "0.31.11",
    "vitest": "5.1.0",
    "wrangler": "4.156.2"
  }
}
